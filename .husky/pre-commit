# Se usan los scripts de npm en lugar de `make registry-gen`: `make` no está
# disponible en todas las máquinas de desarrollo (Windows no lo trae), y sin él
# el hook aborta cualquier commit. Los comandos son los mismos que el objetivo
# `registry-gen` del makefile.
(cd apps/crm && npm run registry:gen)
(cd apps/crm && npx prettier --config ./.prettierrc.json --write "registry.json")
npx lint-staged --cwd apps/crm
git update-index --again
