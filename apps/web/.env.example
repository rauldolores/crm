# Configuración de la integración con el CRM (formulario de demo)
#
# URL base de la API de datos del CRM.
#  - Desarrollo local: http://localhost:3001/api/datos/rest/v1 (CRM corriendo)
#  - Producción:       https://crm.kontrolia.io/api/datos/rest/v1
CRM_API_BASE_URL=http://localhost:3001/api/datos/rest/v1

# Clave de API externa del CRM (formato vnq_...).
# Se crea desde el propio CRM: Ajustes → API / Integraciones.
# ⚠️ Copia este archivo a .env.local y pon ahí tu clave real; nunca comites la clave.
CRM_API_KEY=vnq_pon_aqui_tu_clave

# Etapa (stage) que reciben las oportunidades creadas por el formulario.
# Debe coincidir con un valor de etapa de tu pipeline en Ajustes → Oportunidades.
CRM_DEAL_STAGE=propuesta

# (Opcional) Responsable fijo (id de comercial en el CRM) para las oportunidades
# nuevas. Si se omite, quedan sin asignar.
# CRM_SALES_ID=1
