# Plantilla de variables de entorno de Vinqulia.
#
# Este archivo es la referencia y SÍ se versiona; los .env reales NO.
# El instalador (CLI) genera el .env en la primera ejecución para
# instalaciones locales o en servidor propio. En plataformas como Vercel las
# variables se cargan en la propia plataforma y no existe archivo.
#
# Ninguna clave de aquí es secreta: los anon key son públicos por diseño. El
# service role key y la cadena de conexión de Postgres NO van nunca en un
# archivo de entorno del frontend.

# ── Base de datos del CRM ────────────────────────────────────────────────
# Es del cliente, y normalmente un proyecto distinto del de KontrolIA Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SB_PUBLISHABLE_KEY=

# Bucket de almacenamiento para los archivos adjuntos de las notas.
NEXT_PUBLIC_ATTACHMENTS_BUCKET=attachments

# ── KontrolIA Auth ───────────────────────────────────────────────────────
# El acceso, el registro, los usuarios, los roles, los permisos y las
# organizaciones viven aquí. El CRM no gestiona nada de eso.
NEXT_PUBLIC_KONTROLIA_AUTH_URL=
NEXT_PUBLIC_KONTROLIA_AUTH_ANON_KEY=
NEXT_PUBLIC_KONTROLIA_AUTH_SERVER_URL=https://auth.kontrolia.io

# Cliente OAuth público (PKCE) del CRM. Lo crea el registro de la aplicación
# en KontrolIA Auth, y debe tener dados de alta todos los redirect_uri desde
# los que se vaya a entrar (desarrollo y producción).
NEXT_PUBLIC_KONTROLIA_OAUTH_CLIENT_ID=

# Nombre de la cookie de sesión del CRM. El CRM comparte proyecto de Supabase
# con KontrolIA Auth, así que ambos derivarían el mismo nombre por defecto
# (sb-<ref>-auth-token); si el CRM vive en un subdominio del mismo dominio
# que auth-server (p. ej. crm.kontrolia.io junto a auth.kontrolia.io), la
# cookie de sesión de auth-server —compartida con admin-panel— también llega
# ahí y tapa la del CRM, así que cambiar de organización parece no funcionar.
# Ya trae un valor por defecto razonable; solo cámbialo si necesitas varias
# instalaciones del CRM en el mismo navegador.
NEXT_PUBLIC_COOKIE_NAME=sb-crm-auth-token

# ── Opcionales ───────────────────────────────────────────────────────────
# Modo demostración con datos falsos en el navegador, sin tocar la base.
NEXT_PUBLIC_IS_DEMO=false

# Dirección de captura de correo entrante, si se usa esa integración.
NEXT_PUBLIC_INBOUND_EMAIL=

# Solo servidor: nunca debe llegar al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Cadena de conexión Postgres directa (con el pooler, no la conexión de
# sesión) del proyecto de NEXT_PUBLIC_SUPABASE_URL. La usa el servidor MCP
# (/api/mcp) para ejecutar SQL con RLS del usuario que llama — a diferencia
# del resto del CRM, que solo habla PostgREST. Sin esto, /api/mcp responde
# pero sus tools de consulta y escritura fallan.
# Se obtiene en el panel de Supabase → Project Settings → Database →
# Connection string → Transaction pooler.
SUPABASE_DB_URL=

# ── Correo saliente (responder desde el CRM) ────────────────────────────
# Token de envío de Postmark (Account → API Tokens → Server API tokens) y
# remitente verificado (Postmark → Sender Signatures). Sin esto, el botón
# "Enviar correo" del contacto queda deshabilitado con un aviso.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=

# ── WhatsApp (Twilio) ────────────────────────────────────────────────────
# Cuenta de Twilio con WhatsApp habilitado (sandbox o número verificado) y
# la URL pública exacta de app/api/whatsapp/webhook, tal como está
# configurada en el panel de Twilio (se usa para validar la firma de cada
# mensaje entrante). Sin esto, el botón "Enviar WhatsApp" queda deshabilitado
# y el webhook entrante rechaza todo.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_WEBHOOK_URL=
